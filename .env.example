# Copy to .env.local and fill in. Never commit real keys.

# Providers are tried in this order; the first one that answers wins.
LLM_PROVIDERS=groq,openrouter

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: a smaller/faster model just for parsing player input
# GROQ_REFEREE_MODEL=llama-3.1-8b-instant

# OpenRouter (paid fallback, or set LLM_PROVIDERS=openrouter,groq to make it primary)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_REFEREE_MODEL=

# Encrypts the game state the browser carries. Any long random string.
STATE_SECRET=

# Per-call timeout before falling back to the next provider
LLM_TIMEOUT_MS=12000
