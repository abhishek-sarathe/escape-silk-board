# Copy to .env.local and fill in. Never commit real keys.

# Providers are tried in this order; the first one that answers wins.
LLM_PROVIDERS=openrouter,groq

# OpenRouter (primary): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Narrator, Game Master agent and classic referee (the referee is the agent's fallback).
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_AGENT_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_REFEREE_MODEL=openai/gpt-oss-20b

# Groq (free-tier backup): https://console.groq.com/keys
GROQ_API_KEY=
# Groq rate-limits each model separately, so three different models give three budgets.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REFEREE_MODEL=openai/gpt-oss-120b
# GROQ_AGENT_MODEL=openai/gpt-oss-20b

# Encrypts the game state the browser carries. Any long random string. Required in production.
STATE_SECRET=

# Per-call timeout before falling back to the next provider
LLM_TIMEOUT_MS=12000

# Optional
# REFEREE_MODE=classic         # one-call referee instead of the tool-using Game Master agent
# USAGE_KEY=                   # unlocks GET /api/usage?key=... in production
# LLM_LOG=off                  # turn the LLM call log off
# LLM_LOG_DB=.data/llm-calls.sqlite
